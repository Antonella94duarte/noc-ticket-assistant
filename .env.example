# Copy this file to .env and fill in the values. Never commit .env.

APP_NAME="NOC Ticket Assistant"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Postgres credentials used by docker-compose (local development only).
POSTGRES_USER=noc
POSTGRES_PASSWORD=noc
POSTGRES_DB=noc_tickets

# Used when running the API outside Docker. Inside compose it is overridden to point at "db".
DATABASE_URL=postgresql+psycopg://noc:noc@localhost:5432/noc_tickets

# Needed from phase 1 on.
OPENAI_API_KEY=
OPENAI_MODEL=
