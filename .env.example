# Copy this file to .env and fill in the values. Never commit .env.
# Where to get each provider's key and model: docs/providers-setup.md

APP_NAME="NOC Ticket Assistant"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Postgres credentials used by docker-compose (local development only).
POSTGRES_USER=noc
POSTGRES_PASSWORD=noc
POSTGRES_DB=noc_tickets
# Port published on the host (5433 avoids clashing with a locally installed PostgreSQL).
POSTGRES_HOST_PORT=5433

# Used when running the API outside Docker. Inside compose it is overridden to point at "db".
DATABASE_URL=postgresql+psycopg://noc:noc@localhost:5433/noc_tickets

# Needed for /api/v1/tickets/analyze (returns 503 while unset).
OPENAI_API_KEY=
# Any model that supports Structured Outputs. gpt-6-luna is the cheapest and is enough for triage.
OPENAI_MODEL=gpt-6-luna
# Reasoning effort for the model: none, low, medium, high, xhigh or max (depends on the model).
OPENAI_REASONING_EFFORT=medium
# Timeout per model request, in seconds (each analysis makes two chained requests).
OPENAI_TIMEOUT_SECONDS=60

# --- Agents: model provider (openai, deepseek or ollama) ---
LLM_PROVIDER=openai
# Tried in order when the primary provider fails, e.g. "deepseek,ollama". Each must be configured.
LLM_FALLBACK_PROVIDERS=
# Applied where supported (not to OpenAI reasoning models). Max tokens caps the cost per call.
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4000

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Local models: nothing leaves the machine. From inside Docker use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
# true/false to force thinking on or off for thinking models (qwen3); empty keeps the model default.
OLLAMA_REASONING=
# true/false to force DeepSeek thinking on or off; empty keeps the default (on).
DEEPSEEK_THINKING=
# DeepSeek thinking effort: low, high or max. At high the report step ran out of tokens.
DEEPSEEK_REASONING_EFFORT=low
# Ollama context window in tokens (its default of 4096 is too small for the triage prompt).
OLLAMA_NUM_CTX=16384

# --- Runbook retrieval for the agent: bm25 (offline, free), openai or ollama embeddings ---
RUNBOOK_RETRIEVER=bm25
RUNBOOK_TOP_K=3
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Multilingual; pull it first with: ollama pull bge-m3
OLLAMA_EMBEDDING_MODEL=bge-m3
